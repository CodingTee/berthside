# ---- app ----
APP_NAME=SDOC Shipping Document Verification API
ENVIRONMENT=development
CORS_ORIGINS=*

# ---- data ----
# Static bundle folder (contains inbox/, attachments/, sample_submission.json)
DATA_SOURCE=C:/Users/nicol/Downloads/sdoc-hackathon-bundle
# Or, when the official dataset container is running:
# DATA_SOURCE=http://localhost:8080

# ---- database ----
# Local dev (SQLite file, created automatically):
DATABASE_URL=sqlite:///./sdoc.db
# Supabase / Postgres (production):
# DATABASE_URL=postgresql+psycopg2://postgres:<PASSWORD>@db.<PROJECT>.supabase.co:5432/postgres

# ---- AI (P3 integration) ----
# rule    -> built-in deterministic classifier + regex extractor (offline)
# remote  -> forward everything to P3's AI service
# hybrid  -> remote first, rule engine as fallback (recommended for demo)
AI_PROVIDER=rule
# AI_SERVICE_URL=http://localhost:8001
# AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ---- processing ----
LOG_LEVEL=INFO
