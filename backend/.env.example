# ---- app ----
APP_NAME=SDOC Shipping Document Verification API
ENVIRONMENT=development
CORS_ORIGINS=*

# ---- data ----
# Static bundle folder (contains inbox/, attachments/, sample_submission.json)
# Prefer a relative path: it is resolved against backend/ (see app/config.py),
# so it works on every machine after `git clone` without editing this file.
DATA_SOURCE=../sdoc-hackathon-bundle
# Absolute paths work too, but they are machine-specific:
# DATA_SOURCE=C:/Users/<you>/Downloads/sdoc-hackathon-bundle
# Or, when the official dataset container is running:
# DATA_SOURCE=http://localhost:8080

# ---- database ----
# Local dev (SQLite file, created automatically):
DATABASE_URL=sqlite:///./sdoc.db
# Supabase / Postgres (production):
# DATABASE_URL=postgresql+psycopg2://postgres:<PASSWORD>@db.<PROJECT>.supabase.co:5432/postgres

# ---- AI (P3 integration) ----
# rule    -> built-in deterministic classifier + regex extractor (offline)
# remote  -> forward everything to P3's AI service
# hybrid  -> remote first, rule engine as fallback (recommended for demo)
AI_PROVIDER=rule
# AI_SERVICE_URL=http://localhost:8001
# AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ---- processing ----
LOG_LEVEL=INFO

# ---- Gmail integration (Real Gmail live demo) ----
# Dedicated demo inbox. This is safe to commit; OAuth secrets/tokens are not.
GMAIL_DEMO_ACCOUNT=averis.demo@gmail.com
# Put your Google OAuth client JSON here locally. Do not commit this file.
GMAIL_CREDENTIALS_FILE=secrets/google_oauth_client.json
# ShipSync writes the OAuth user token here after /api/gmail/oauth-callback.
GMAIL_TOKEN_FILE=secrets/gmail_token.json
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/oauth-callback
GMAIL_QUERY=in:inbox has:attachment
GMAIL_MAX_RESULTS=10
GMAIL_POLLING_ENABLED=false
GMAIL_POLL_INTERVAL_SECONDS=60

# ---- Real Email Channel (IMAP Inbound & SMTP Outbound) ----
# Configure these to enable end-to-end testing with your private Gmail!
# System Service Mailbox (where you send documents to, and which sends replies back to you):
# For Gmail: host=smtp.gmail.com:587 / imap.gmail.com:993, password=16-digit Google App Password
# For Outlook/Hotmail: host=smtp.office365.com:587 / outlook.office365.com:993
# For QQ/163: host=smtp.qq.com:465 (SSL) / imap.qq.com:993, password=authorization code

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_SECONDS=30
AUTO_REPLY_ON_VERIFICATION=true

