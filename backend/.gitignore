# -------- Python --------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# -------- secrets / env --------
.env
*.env
!.env.example
secrets/

# -------- local runtime data --------
*.db
*.sqlite
*.sqlite3
sdoc.db
submission.json
process_all_result.json

# -------- datasets (never commit the hackathon bundle) --------
# Anchored to the backend root on purpose: these are the GENERATED dataset
# folders (scripts/prepare_data.py writes backend/data). An unanchored `data/`
# would also swallow backend/simulated-gmail/data, which is committed static
# demo data for the Simulated Gmail UI.
/data/
/inbox/
/attachments/

# -------- local reports --------
stress_report.json
_stress_sub.json

# -------- one-off cleanup backups (scripts/clean_ingest_pollution.py) --------
cleanup-backup-*/
