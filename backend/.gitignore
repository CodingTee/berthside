# -------- Python --------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# -------- secrets / env --------
.env
*.env
!.env.example
secrets/

# -------- local runtime data --------
*.db
*.sqlite
*.sqlite3
sdoc.db
submission.json
process_all_result.json

# -------- datasets (never commit generated data) --------
# Anchored to the backend root: these are the GENERATED dataset folders
# (scripts/prepare_data.py writes backend/data). The static evaluation corpus
# in data/corpus is committed on purpose. An unanchored `data/` would also
# swallow backend/simulated-gmail/data, committed static demo data.
/data/*
!/data/corpus
/inbox/
/attachments/

# -------- local reports --------
stress_report.json
_stress_sub.json

# -------- one-off cleanup backups (scripts/clean_ingest_pollution.py) --------
cleanup-backup-*/

# -------- generated outputs --------
generated_drafts/
tmp_test/
.grouping_*.json
