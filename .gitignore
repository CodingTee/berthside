# ============================================================
#  BerthSide
#  Source, docs and the evaluation corpus are committed; local
#  runtime artifacts never are.
# ============================================================

# --- NEVER commit: private evaluation material ---
sdoc-hackathon-docker/
sdoc-hackathon-docker.zip
sdoc-hackathon-bundle.zip

# --- generated data (only data/corpus is committed) ---
/data/*
!/data/corpus
submission.json
stress_report.json
_stress_sub.json
process_all_result.json
pdf_text.txt
.grouping_*.json

# --- dev scratch / one-off scripts (hardcoded local paths) ---
_cleanup_needed/
_tmp_verify/
/_*.py
/_*.js
/_*.html
_crop_*.png
*_baseline_backup.html
scripts/build_shipmail_from_friend.py
tmp_test/
generated_drafts/
cleanup-backup-*/
diff_summary.txt

# --- UI verification screenshots (README does not reference them) ---
images/shot_*.png

# --- python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
# Scratch --basetemp directories. The safe-delete shim used in this sandbox
# refuses to remove them, so they must not be able to reach a commit.
.pytest_tmp*/
.pt_*/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- node / frontend build artifacts ---
node_modules/
dist/
build/
.cache/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- local databases / runtime data ---
*.db
*.sqlite
*.sqlite3

# --- local inbox snapshots taken before each mock merge ---
web/shipmail/data/emails.before-*.json

# --- environments & secrets ---
.env
.env.*
!.env.example
*.key
*.pem
# Keynote decks are also .key, so the mock corpus is exempted.
!web/shipmail/data/attachments/mock_special100/*.key
secrets/

# --- editors / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
*.bak
*.orig
*.rej

# --- local dev scratch (never commit) ---
.workbuddy/
*.log
.git.corrupt-*/
.tmp-reclone/

# --- common temp files / download leftovers ---
*.tmp
*.crdownload
*.part
tmp/
temp/
