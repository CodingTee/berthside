# ============================================================
#  ShipSync · Averis x Monash Hackathon 2026
#  只提交源码 + 文档 + 官方数据集，其余本地产物一律不入库
#  注意：git 只能忽略「仓库内」的路径；仓库外的目录（如桌面上的
#  「averis-hackathon-2026 - 副本」备份、WorkBuddy 会话目录）本文件管不到。
# ============================================================

# --- NEVER commit: evaluation material with answers / generator source ---
sdoc-hackathon-docker/
sdoc-hackathon-docker.zip
sdoc-hackathon-bundle.zip

# --- generated artifacts (regenerate with pipeline.py) ---
pipeline/submission.json
app/data/reviews.json

# --- dev scratch scripts (hardcoded local paths) ---
pipeline/debug_*.py

# --- 本地验证 / 调试临时产物（WorkBuddy 跑 headless 校验时产生，勿提交）---
_cleanup_needed/
_tmp_verify/
/_*.py
/_*.js
/_*.html
/backend/web/_*.html
/backend/web/_*.js
_crop_*.png

# --- 前端改造过程中的本地备份（改版前的 baseline，属个人存档）---
backend/web_baseline_backup.html
*_baseline_backup.html

# --- UI 验证截图（42 张 / 约 12MB，README 未引用）---
