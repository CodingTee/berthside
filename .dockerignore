# Keep the build context small: the image only needs backend/ and
# the evaluation corpus in backend/data/corpus/.
.workbuddy/
.git/
.github/
sdoc-hackathon-docker/
sdoc-hackathon-docker.zip
sdoc-hackathon-bundle.zip
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/*.db
**/*.sqlite*
# Only the GENERATED dataset files are skipped (scripts/prepare_data.py writes
# backend/data). The evaluation corpus (backend/data/corpus) MUST stay in the
# image, and so must the ShipMail demo data (backend/shipmail/data).
backend/data/*
!backend/data/corpus
**/_stress_sub.json
**/stress_report.json
**/submission.json
**/process_all_result.json
**/*.log
**/.env
**/.env.*
!**/.env.example
