# Keep the build context small: the image only needs backend/ and
# sdoc-hackathon-bundle/.
.workbuddy/
.git/
.github/
sdoc-hackathon-docker/
sdoc-hackathon-docker.zip
sdoc-hackathon-bundle.zip
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/*.db
**/*.sqlite*
# Only the GENERATED dataset folder is skipped (scripts/prepare_data.py writes
# backend/data). The ShipMail demo data (backend/shipmail/data) MUST stay in the
# image — it is the static inbox the UI loads.
backend/data/
**/_stress_sub.json
**/stress_report.json
**/submission.json
**/process_all_result.json
**/*.log
**/.env
**/.env.*
!**/.env.example
