# Keep the build context small: the image only needs the source tree and
# the evaluation corpus in data/corpus/.
.workbuddy/
.git/
.github/
sdoc-hackathon-docker/
sdoc-hackathon-docker.zip
sdoc-hackathon-bundle.zip
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/*.db
**/*.sqlite*
# Only the GENERATED dataset files are skipped (scripts/prepare_data.py writes
# data/). The evaluation corpus (data/corpus) MUST stay in the image, and so
# must the ShipMail demo data (web/shipmail/data).
data/*
!data/corpus
**/_stress_sub.json
**/stress_report.json
**/submission.json
**/process_all_result.json
**/*.log
**/.env
**/.env.*
!**/.env.example
