# ---- app ----
APP_NAME=SDOC Shipping Document Verification API
ENVIRONMENT=development
CORS_ORIGINS=*

# ---- data ----
# Static corpus folder (contains inbox/, attachments/, sample_submission.json)
# Prefer a relative path: it is resolved against the repository root (see app/config.py),
# so it works on every machine after `git clone` without editing this file.
DATA_SOURCE=data/corpus
# Absolute paths work too, but they are machine-specific:
# DATA_SOURCE=C:/path/to/BerthSide/data/corpus
# Or, when the dataset server container is running:
# DATA_SOURCE=http://localhost:8080

# ---- database ----
# Local dev (SQLite file in data/, created automatically):
DATABASE_URL=sqlite:///./data/sdoc.db
# Supabase / Postgres (production):
# DATABASE_URL=postgresql+psycopg2://postgres:<PASSWORD>@db.<PROJECT>.supabase.co:5432/postgres

# ---- AI (P3 integration) ----
# rule    -> built-in deterministic classifier + regex extractor (offline)
# remote  -> forward everything to P3's AI service
# hybrid  -> remote first, rule engine as fallback (recommended for demo)
AI_PROVIDER=rule
# AI_SERVICE_URL=http://localhost:8001
# AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ---- Ollama (local GPU, or any remote endpoint that speaks the Ollama API) ----
# Point OLLAMA_BASE_URL at wherever Ollama listens: a local install, a LAN box,
# or a public HTTPS endpoint (tunnel / reverse proxy / cloud GPU). No code change
# is needed to move between them; only this URL changes.
# Set AI_PROVIDER=ollama to use it alone, or cascade to keep cloud LLM first.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl:7b
# Sent as `Authorization: Bearer <key>` when set. Ollama itself has no auth, so
# this only matters when a reverse proxy in front of it checks the header.
# OLLAMA_API_KEY=
#
# Cold start. The liveness probe is quick by default so a warm endpoint answers
# instantly; when it times out the probe retries once on the cold-start budget,
# so a tunnel still coming up or a host still waking is not read as offline.
# /api/chat has its own budget, and that is where loading a model into VRAM is
# paid. Raise these for a remote GPU, lower them for a local install.
# OLLAMA_PROBE_TIMEOUT_SECONDS=2
# OLLAMA_COLD_START_TIMEOUT_SECONDS=90
# OLLAMA_REQUEST_TIMEOUT_SECONDS=180

# ---- processing ----
LOG_LEVEL=INFO

# ---- Gmail integration (Real Gmail live demo) ----
# Dedicated demo inbox. This is safe to commit; OAuth secrets/tokens are not.
GMAIL_DEMO_ACCOUNT=averis.demo@gmail.com
# Put your Google OAuth client JSON here locally. Do not commit this file.
GMAIL_CREDENTIALS_FILE=secrets/google_oauth_client.json
# BerthSide writes the OAuth user token here after /api/gmail/oauth-callback.
GMAIL_TOKEN_FILE=secrets/gmail_token.json
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/oauth-callback
GMAIL_QUERY=in:inbox has:attachment
GMAIL_MAX_RESULTS=10
GMAIL_POLLING_ENABLED=false
GMAIL_POLL_INTERVAL_SECONDS=60

# ---- Gmail Official REST API Outbound (HTTPS:443) ----
# Zero domain setup, 100% deliverability, bypasses Render.com SMTP port blocking.
# Outbound emails are sent directly through Google's official REST API from averis.demo@gmail.com.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- Real Email Channel (Resend.com REST API & IMAP Inbound) ----
# Resend REST API (HTTPS:443) - Secondary option for Render.com (SMTP ports 25/465/587 are blocked on Render)
RESEND_API_KEY=
# Default testing sender: Averis SDOC Hub <onboarding@resend.dev>
# If custom domain is verified in resend.com: Averis Ops <ops@yourdomain.com>
RESEND_FROM=Averis SDOC Hub <onboarding@resend.dev>

# ---- Source Trust Matrix Extra Whitelist (comma-separated) ----
# Complements the built-in defaults. Put the mailbox you will demo from here
# (e.g. your own Gmail), locally or as a Render env var. Entries can also be
# added at runtime from the hub console; both land in the same matrix.
EXTRA_TRUSTED_SOURCES=

# ---- Standard SMTP Outbound (Fallback / Local Channel) ----
# If RESEND_API_KEY is not set, system seamlessly falls back to SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_SECONDS=30
AUTO_REPLY_ON_VERIFICATION=true

